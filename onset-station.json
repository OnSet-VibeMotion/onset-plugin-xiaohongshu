{
  "manifest_version": 1,
  "requires": {
    "onset": "0.1.0"
  },
  "id": "xiaohongshu-upload",
  "version": "0.3.2",
  "name": "小红书上传助手",
  "description": "选择小红书账号，在片场客户端内自动上传成片、封面并填入文案，最后由你检查并发布。",
  "after": "publish",
  "prompt": "prompt.md",
  "nodes": [
    {
      "id": "xiaohongshu-upload",
      "label": "上传到小红书",
      "step": "publish",
      "page": "accounts",
      "stale_after": [
        "publish",
        "review"
      ],
      "state": {
        "file": "production/xiaohongshu/state.json",
        "json": "status",
        "cases": [
          {
            "is": "ready_to_publish",
            "status": "done",
            "detail": "已填写，请在小红书页面手动发布"
          },
          {
            "is": "running",
            "status": "doing",
            "detail": "正在准备小红书内容"
          },
          {
            "is": [
              "error",
              "interrupted"
            ],
            "status": "doing",
            "detail": "请检查小红书窗口或重新准备",
            "waiting": "user"
          }
        ],
        "missing": {
          "status": "todo",
          "waiting": "user"
        }
      }
    }
  ],
  "produces": [
    {
      "prefix": "production/xiaohongshu/"
    }
  ],
  "ops": [
    {
      "name": "accounts",
      "summary": "小红书账号",
      "trigger": "user",
      "project": false,
      "list": true,
      "command": [
        "{node}",
        "dist/plugin.cjs",
        "accounts"
      ],
      "params": {}
    },
    {
      "name": "login",
      "summary": "登录小红书账号",
      "description": "在片场里打开小红书登录页，登录好后自动记下昵称与头像，回到片场。",
      "trigger": "user",
      "project": false,
      "command": [
        "{node}",
        "dist/plugin.cjs",
        "login"
      ],
      "params": {}
    },
    {
      "name": "open_account",
      "summary": "打开这个账号的小红书窗口",
      "trigger": "user",
      "project": false,
      "form": false,
      "command": [
        "{node}",
        "dist/plugin.cjs",
        "open_account"
      ],
      "params": {
        "account": {
          "type": "string",
          "description": "账号编号",
          "required": true
        }
      }
    },
    {
      "name": "remove_account",
      "summary": "移除账号",
      "trigger": "user",
      "project": false,
      "form": false,
      "command": [
        "{node}",
        "dist/plugin.cjs",
        "remove_account"
      ],
      "params": {
        "account": {
          "type": "string",
          "description": "账号编号",
          "required": true
        }
      }
    },
    {
      "name": "prepare",
      "summary": "上传视频和封面并填写小红书文案（不提交发布）",
      "trigger": "user",
      "form": false,
      "command": [
        "{node}",
        "dist/plugin.cjs",
        "prepare"
      ],
      "params": {
        "account": {
          "type": "string",
          "description": "账号编号",
          "required": true
        }
      }
    }
  ],
  "pages": [
    {
      "id": "accounts",
      "label": "小红书",
      "entry": "ui/index.html",
      "reads": [
        "production/xiaohongshu/"
      ]
    }
  ],
  "slots": [
    {
      "at": "publish",
      "page": "accounts",
      "height": 440
    }
  ],
  "settings": [],
  "browser": {
    "origins": [
      "https://creator.xiaohongshu.com",
      "https://www.xiaohongshu.com"
    ]
  }
}
